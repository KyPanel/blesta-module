<?php
$this->Widget->clear();
$this->Widget->setLinkButtons([
    [
        'name' => $this->_('Kypanel.back_to_manage', true),
        'icon' => 'bi bi-arrow-left me-1',
        'attributes' => ['href' => $this->base_uri . 'settings/company/modules/manage/' . ($module->id ?? '')],
    ],
]);
$this->Form->create(null, ['class' => 'disable-on-submit']);
$this->Widget->create($this->_(isset($editing) ? 'Kypanel.edit_row.title' : 'Kypanel.add_row.title', true));
?>
    <div class="mb-3">
        <label for="server_name" class="form-label"><?php $this->_('Kypanel.row_meta.server_name'); ?></label>
        <?php $this->Form->fieldText('server_name', $vars->server_name ?? null, ['id' => 'server_name', 'class' => 'form-control']); ?>
    </div>

    <div class="mb-3">
        <label for="host_name" class="form-label"><?php $this->_('Kypanel.row_meta.host_name'); ?></label>
        <?php $this->Form->fieldText('host_name', $vars->host_name ?? null, ['id' => 'host_name', 'class' => 'form-control', 'placeholder' => 'server.example.com']); ?>
    </div>

    <div class="mb-3">
        <label for="port" class="form-label"><?php $this->_('Kypanel.row_meta.port'); ?></label>
        <?php $this->Form->fieldText('port', $vars->port ?? '7711', ['id' => 'port', 'class' => 'form-control']); ?>
    </div>

    <div class="mb-3">
        <label for="api_token" class="form-label"><?php $this->_('Kypanel.row_meta.api_token'); ?></label>
        <?php $this->Form->fieldPassword('api_token', ['id' => 'api_token', 'class' => 'form-control', 'value' => $vars->api_token ?? null, 'autocomplete' => 'off']); ?>
        <div class="form-text"><?php $this->_('Kypanel.row_meta.api_token_help'); ?></div>
    </div>

    <div class="mb-3">
        <div class="form-check">
            <?php $this->Form->fieldCheckbox('verify_ssl', 'true', ($vars->verify_ssl ?? 'true') == 'true', ['id' => 'verify_ssl', 'class' => 'form-check-input']); ?>
            <label for="verify_ssl" class="form-check-label"><?php $this->_('Kypanel.row_meta.verify_ssl'); ?></label>
        </div>
    </div>

    <?php $this->Widget->footer(); ?>
    <div class="d-flex justify-content-end">
        <?php $this->Form->fieldSubmit('save', $this->_(isset($editing) ? 'Kypanel.edit_row.save' : 'Kypanel.add_row.save', true), ['class' => 'btn btn-primary']); ?>
    </div>
<?php $this->Widget->end(); ?>
<?php $this->Form->end(); ?>
